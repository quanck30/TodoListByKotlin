<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/surface"
    >
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        app:titleTextAppearance="@style/TextAppearance.Todo.Title"
        app:title="やることリスト"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/background"
        android:padding="@dimen/spacing_base"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolBar"
        >

        <TextView
            android:id="@+id/subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10月21日（水）  ·  今日も、ひとつずつ。"
            android:textAppearance="@style/TextAppearance.Todo.Caption"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchInputLayout"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_search_height"
            android:layout_marginTop="@dimen/spacing_base"
            app:layout_constraintTop_toBottomOf="@id/subTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/surface"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:boxCornerRadiusTopStart="@dimen/radius_full"
            app:boxCornerRadiusTopEnd="@dimen/radius_full"
            app:boxCornerRadiusBottomStart="@dimen/radius_full"
            app:boxCornerRadiusBottomEnd="@dimen/radius_full"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/text_secondary"
            >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="タスクを検索"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Todo.Body"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:singleLine="true"
                />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChipGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_base"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:singleLine="true"
            app:chipSpacingHorizontal="@dimen/spacing_sm"
            app:checkedChip="@id/chipAll"
            app:layout_constraintTop_toBottomOf="@+id/searchInputLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >
            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Todo.FilterChip"
                android:text="すべて"
                />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipIncomplete"
                style="@style/Widget.Todo.FilterChip"
                android:text="未完了"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipCompleted"
                style="@style/Widget.Todo.FilterChip"
                android:text="完了"/>
        </com.google.android.material.chip.ChipGroup>
        <LinearLayout
            android:id="@+id/listHeading"
            android:layout_width="0dp"
            android:layout_height="@dimen/list_heading_height"
            android:layout_marginTop="@dimen/spacing_base"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/filterChipGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:id="@+id/tvTaskLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="タスク"
                android:textAppearance="@style/TextAppearance.Todo.CardTitle"
                />
            <TextView
                android:id="@+id/tvTaskCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3件"
                android:textAppearance="@style/TextAppearance.Todo.Caption"
                android:layout_marginStart="@dimen/spacing_sm"
                />
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                />
            <ImageView
                android:id="@+id/ivSort"
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:src="@drawable/ic_sort"
                app:tint="@color/text_secondary"
                />
            <TextView
                android:id="@+id/tvSortLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Todo.Caption"
                android:text="期限順"
                android:layout_marginStart="@dimen/spacing_sm"
                />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTasks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_base"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/tvRemaining"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/listHeading"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"
            tools:itemCount="3"
            tools:listitem="@layout/item_task" />
        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.Todo.Caption"
            tools:text="2件のタスクが残っています"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvTasks"
            app:layout_constraintBottom_toBottomOf="parent"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:fabCustomSize="@dimen/fab_size"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/surface"
        app:backgroundTint="@color/primary"
        app:elevation="0dp"
        android:contentDescription="タスクを追加"
        android:layout_marginEnd="@dimen/spacing_base"
        android:layout_marginBottom="@dimen/spacing_base"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>